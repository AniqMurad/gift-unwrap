{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "proxy": {
    "entrypoint": "proxy.js",
    "matcher": [
      "/((?!api(?:/|$)|assets(?:/|$)|favicon\\.png$|robots\\.txt$|sitemap\\.xml$|.*\\.[^/]+$).*)"
    ]
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "functions": {
    "api/render.js": {
      "includeFiles": [
        "server-dist/**",
        "dist/index.html"
      ],
      "maxDuration": 30
    }
  }
}
